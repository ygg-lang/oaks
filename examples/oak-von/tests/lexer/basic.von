# VON (Value Object Notation) Comprehensive Lexer Test
# A configuration format combining features of JSON, YAML, and TOML

# Key-Value Pairs
key = "value"
number = 123
float = 3.14
boolean = true
null_value = null

# Strings
single_quoted = 'This is a string'
double_quoted = "This is also a string"
multiline = """
    This is a multiline string
    that spans multiple lines
"""

# Arrays
list = [1, 2, 3, "four", true]
matrix = [
    [1, 0, 0],
    [0, 1, 0],
    [0, 0, 1]
]

# Objects / Maps
user = {
    name: "Alice",
    age: 30,
    active: true,
    roles: ["admin", "editor"]
}

# Nested Structures
config = {
    database: {
        host: "localhost",
        port: 5432,
        credentials: {
            user: "db_user",
            pass: "secret"
        }
    },
    server: {
        port: 8080,
        debug: false
    }
}

# Comments
// C-style comment
/* Block comment */
# Bash-style comment

# Identifiers
identifier_with_underscores = 1
identifier-with-dashes = 2
identifier.with.dots = 3

# Units (if supported)
duration = 10s
size = 512kb

# Date and Time
timestamp = 2023-10-27T10:00:00Z
date = 2023-10-27

# References / Anchors (YAML-like)
&anchor_name
*anchor_reference

# Complex Keys
"quoted key": "value"
'single quoted key': "value"
123: "numeric key"

# Hex, Octal, Binary
hex = 0xFF
oct = 0o777
bin = 0b1010

# Infinity and NaN
inf = Infinity
nan = NaN
